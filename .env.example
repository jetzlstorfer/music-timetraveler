# At least one of the two providers must be configured. Both modes are
# fully featured: the app supports Last.fm-only, Spotify-only, or both
# simultaneously. Leave LASTFM_API_KEY blank to run in Spotify-only mode.
LASTFM_API_KEY=your_api_key_here

# Timezone used to convert scraped Last.fm library dates into unix timestamps.
# Example values: Europe/Vienna, UTC, America/New_York
# LASTFM_LIBRARY_TIMEZONE=Europe/Vienna

# By default the app uses a local SQLite file for development.
DB_PATH=timetraveler.db

# To exercise the Azure Cosmos DB code path locally, run the Cosmos emulator and set:
# COSMOS_CONNECTION_STRING=AccountEndpoint=http://localhost:8081/;AccountKey=<emulator-key>;
# COSMOS_DATABASE_NAME=lastfm-timetraveler
# COSMOS_CONTAINER_NAME=searches

# Alternatively, use endpoint + key instead of a connection string:
# COSMOS_ENDPOINT=http://localhost:8081/
# COSMOS_KEY=<emulator-key>

# ---- Spotify OAuth -----------------------------------------------------------
# Register an app at https://developer.spotify.com/dashboard. Copy the client
# id and secret here, and add the redirect URI to the app's "Redirect URIs".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match the Redirect URI registered with Spotify.
# Local dev:  http://127.0.0.1:5000/api/spotify/callback
# Production: https://<your-app>.azurecontainerapps.io/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback

# 32-byte url-safe base64 key used to encrypt Spotify refresh tokens at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# ---- Custom domain (Azure deployment only) ------------------------------------
# Set these to preserve your custom domain across `azd up` / `azd provision`
# runs. Both values must be set together; leaving either blank skips the custom
# domain binding and only the auto-generated *.azurecontainerapps.io URL is used.
#
# CUSTOM_DOMAIN_NAME is the hostname you've added in the Azure portal, e.g.:
#   CUSTOM_DOMAIN_NAME=musictimetraveler.example.com
#
# CUSTOM_DOMAIN_CERTIFICATE_ID is the full resource ID of the managed certificate
# in your Container Apps Environment. Find it in the Azure portal under:
#   Container Apps Environment > Certificates > <your cert> > Properties > Resource ID
# It looks like:
#   /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.App/managedEnvironments/<env>/certificates/<cert-name>
#
# CUSTOM_DOMAIN_NAME=
# CUSTOM_DOMAIN_CERTIFICATE_ID=
